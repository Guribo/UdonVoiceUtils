      Data: 60|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "Growth factor for exponential partition bucketing. Each partition is
        growthFactor times larger than the previous. Default 4 creates bin sizes
        that distribute emitters 1:4:16:... to prioritize distant-source culling.
        Range: 2\u20136 (lower = more uniform; higher = more skewed)."
